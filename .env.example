# Ключи Яндекс Карт (кабинет: https://developer.tech.yandex.ru).
# Скопируйте файл в .env.local и впишите свои значения, затем перезапустите npm run dev.

# «JavaScript API»: сама карта и редактор зоны.
# В настройке ключа, в поле «Ограничение по HTTP Referer», должны быть localhost и боевой домен.
VITE_YMAPS_KEY=

# «API Геокодера»: проверка адреса на зону доставки.
VITE_YGEOCODER_KEY=

# «API Геосаджест»: подсказки при вводе адреса. Необязателен.
VITE_YSUGGEST_KEY=
